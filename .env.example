# ==========================================
# Application Configuration
# ==========================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.onrender.com

# ==========================================
# Database & Cache
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
REDIS_URI=redis://<username>:<password>@<host>:<port>

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/auth/github/callback

# ==========================================
# Third-Party APIs
# ==========================================
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# ==========================================
# Frontend Specific (Vite Environment Variables)
# ==========================================
VITE_NODE_API_URL=https://your-backend.onrender.com
VITE_GITHUB_CLIENT_ID=your_github_client_id
